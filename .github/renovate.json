{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>newrelic/newrelic-agent-control//.github/renovate-shared-base.json"
  ],
  // `config:recommended` uses `ignoreModulesAndTests`, which ignores **/test/** paths.
  // However, we want to be able to update the k8s version cluster in the `eks_cluster`
  // terraform module that we can find inside `test/k8s-canaries/terraform/modules`.
  // For that reason, we override `ignorePaths`. The following is a copy from the above
  // mentioned preset without the `**/test/**` glob pattern.
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  // Taking the above comment into account, we are ignoring everything else in the test folder.
  "packageRules": [
    {
      "matchFileNames": [
        "**/test/**"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "**/test/**/eks_cluster/variables.tf"
      ],
      "enabled": true
    },
    // The packaging build is not a required check, so a GoReleaser bump needs a manual review.
    {
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ],
      "automerge": false
    }
  ],
  // Resolves to the latest patch of the third newest Kubernetes minor, since we support the three
  // latest minors (endoflife.date lists cycles newest first).
  "customDatasources": {
    "k8s-oldest-supported": {
      "defaultRegistryUrlTemplate": "https://endoflife.date/api/kubernetes.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [ { \"version\": \"v\" & $[2].latest } ] }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfiles/Dockerfile_agent_control_cli$/"
      ],
      "depNameTemplate": "alpine/helm",
      "datasourceTemplate": "docker",
      "matchStrings": [
        "FROM alpine/helm:(?<currentValue>\\S+) AS helm"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfiles/Dockerfile_agent_control_cli$/"
      ],
      "depNameTemplate": "alpine/kubectl",
      "datasourceTemplate": "docker",
      "matchStrings": [
        "FROM alpine/kubectl:(?<currentValue>\\S+) AS kubectl"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*runner: [a-z]+-(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>v\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/eks_cluster/variables.tf"
      ],
      "matchStrings": [
        "variable \"k8s_version\" {\n(.*\n)*?(..default.*=.*\"(?<currentValue>.*)\")\n(.*\n)*?}"
      ],
      "datasourceTemplate": "endoflife-date",
      "depNameTemplate": "amazon-eks",
      "extractVersionTemplate": "^(?<version>.*)-eks.+$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubernetes-version: \"(?<currentValue>v\\S+?)\""
      ],
      "datasourceTemplate": "custom.k8s-oldest-supported",
      "depNameTemplate": "kubernetes",
      "versioningTemplate": "semver"
    }
  ]
}
