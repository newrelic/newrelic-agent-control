[Unit]
Description=New Relic Agent Control
After=network.target

[Service]
# kept for backward compatibility. The environment_variables.yaml is used instead for new installs.
EnvironmentFile=/etc/newrelic-agent-control/systemd-env.conf
ExecStart=/usr/bin/newrelic-agent-control
KillMode=mixed
Restart=always
RestartSec=20
StartLimitIntervalSec=0 # 0 removes the burst rate limit so systemd retries indefinitely.
Type=simple
# Hard memory limit for the entire Agent Control process tree (AC + all child agents).
# Breakdown:
#   350M  - Agent Control itself + headroom for unexpected growth
#   1024M - infra-agent + Fluent Bit + integrations (hard limit)
#   1024M - eBPF agent (hard limit)
#   nrdot  - 100M default, configurable via NEW_RELIC_MEMORY_LIMIT_MIB
# Note: infra-agent and nrdot cannot run together, so the 1024M infra-agent budget
# already covers the nrdot case.
MemoryMax=2400M

[Install]
WantedBy=multi-user.target
